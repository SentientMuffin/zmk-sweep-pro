#define ZMK_POINTING_DEFAULT_MOVE_VAL 2500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#include "behaviors/character_map.dtsi"
#include "behaviors/report.dtsi"

// Layers (ported from corne, MSE retained from sweep)
#define BASE   0
#define SYMB   1
#define NUM    2
#define FUNC   3
#define XDRIVE 4
#define MDRIVE 5
#define MOUSE  6
#define NAV    7
#define BT     8

// Pointer / Cirque mode tokens (used by the mouse layer)
#define SPEED_POINTER 0
#define SPEED_SCROLL 1
#define SPEED_PREV 0
#define SPEED_NEXT 1
#define SPEED_RESET 2
#define SPEED_FINE_PREV 3
#define SPEED_FINE_NEXT 4
#define CIRQUE_MODE_RELATIVE 0
#define CIRQUE_MODE_ABSOLUTE 1
#define CIRQUE_MODE_TOGGLE 2

// Sticky-key behavior (ported from corne; used by &sk LALT / &sk LCTRL in Base)
&sk {
	quick-release;
};

&sensors {
	left_encoder {
		triggers-per-rotation = <15>;
	};
	right_encoder {
		triggers-per-rotation = <45>;
	};
};

&glidepoint_listener {
	input-processors = <&pointer_processor 0 0 &drag_scroll_processor 1 8>;
};

/ {
	pointer_processor: pointer_processor {
		compatible = "zmk,input-processor-pointer-speed";
		#input-processor-cells = <2>;
		track-remainders;
		pointer-curve = "adaptive";
		pointer-curve-deadzone = <2>;
		pointer-curve-accel-multiplier = <1>;
		pointer-curve-accel-divisor = <12>;
		pointer-curve-max-delta = <120>;
		one-x-multiplier = <1>;
		one-x-divisor = <1>;
		min-percent = <10>;
		max-percent = <400>;
		initial-speed-position = <50>;
	};

	drag_scroll_processor: drag_scroll_processor {
		compatible = "zmk,input-processor-drag-scroll";
		#input-processor-cells = <2>;
		track-remainders;
		native-wheel-axis = "horizontal-when-enabled";
		scroll-min-step = <1>;
		one-x-multiplier = <1>;
		one-x-divisor = <1>;
		min-percent = <10>;
		max-percent = <1000>;
		initial-speed-position = <50>;
	};

	behaviors {
		/* Tap-hold behaviors ported from corne */
		hm: homerow_mods {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			tapping-term-ms = <175>;
			quick-tap-ms = <0>;
			flavor = "tap-preferred";
			bindings = <&kp>, <&kp>;
		};
		hltk: holdlayer_tapkey {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			tapping-term-ms = <175>;
			quick-tap-ms = <0>;
			flavor = "tap-preferred";
			bindings = <&mo>, <&kp>;
		};

		/* Mouse / pointer behaviors (sweep) */
		drgscrl: drag_scroll {
			compatible = "zmk,behavior-drag-scroll";
			#binding-cells = <0>;
		};
		ptr_spd: pointing_speed {
			compatible = "zmk,behavior-pointing-speed";
			#binding-cells = <2>;
		};
		enc_ptr_spd: encoder_pointer_speed {
			compatible = "zmk,behavior-sensor-rotate";
			#sensor-binding-cells = <0>;
			bindings = <&ptr_spd SPEED_POINTER SPEED_PREV>, <&ptr_spd SPEED_POINTER SPEED_NEXT>;
		};
		enc_scrl_spd: encoder_scroll_speed {
			compatible = "zmk,behavior-sensor-rotate";
			#sensor-binding-cells = <0>;
			bindings = <&ptr_spd SPEED_SCROLL SPEED_PREV>, <&ptr_spd SPEED_SCROLL SPEED_NEXT>;
		};
		crq_mode: crqm {
			compatible = "zmk,behavior-cirque-mode";
			#binding-cells = <1>;
		};
		mmv {
			acceleration-exponent = <1>;
			time-to-max-speed-ms = <300>;
			delay-ms = <0>;
		};
		msc {
			acceleration-exponent = <0>;
			time-to-max-speed-ms = <40>;
			delay-ms = <0>;
		};
	};

	combos {
		compatible = "zmk,combos";
    // X + C 
    combo_mouse {
			timeout-ms = <50>;
			key-positions = <21 22>;
			layers = <BASE>;
			bindings = <&to MOUSE>;
    };
		// W + E (left ring + middle, top row)
		combo_tab {
			timeout-ms = <50>;
			key-positions = <1 2>;
			layers = <BASE>;
			bindings = <&kp TAB>;
		};
		// S + D (left ring + middle, home row)
		combo_esc {
			timeout-ms = <50>;
			key-positions = <11 12>;
			layers = <BASE>;
			bindings = <&kp ESC>;
		};
    combo_exit {
 			timeout-ms = <50>;
			key-positions = <11 12>;
			layers = <MOUSE>;
			bindings = <&tog MOUSE>;
   };
		// D + F (left middle + index)
		combo_lgui {
			timeout-ms = <50>;
			key-positions = <12 13>;
			layers = <BASE>;
			bindings = <&kp LGUI>;
		};
		// N + K (right)
		combo_rgui {
			timeout-ms = <50>;
			key-positions = <16 17>;
			layers = <BASE>;
			bindings = <&kp RGUI>;
		};
		// K + O (right)
		combo_backspace {
			timeout-ms = <50>;
			key-positions = <17 18>;
			layers = <BASE>;
			bindings = <&kp BSPC>;
		};
		// P + the Ctrl key to its right (bottom row)
		combo_enter {
			timeout-ms = <50>;
			key-positions = <27 28>;
			layers = <BASE>;
			bindings = <&kp RET>;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Base";
			bindings = <
			&kp Q &kp W          &kp E &kp R &kp T    &kp Y                &kp U &kp I &sk LALT  &kp BSPC
			&kp A &kp S          &kp D &kp F &kp G    &kp H                &kp N &kp K &kp O     &kp L
			&kp Z &hltk XDRIVE X &kp C &kp V &kp B    &kp J &hltk MDRIVE M &kp P &sk LCTRL &kp CAPS

			&none &mo NUM &hltk NAV SPACE    &kp LSHFT &mo SYMB &none
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
		};

		symbs_layer {
			display-name = "Symb";
			bindings = <
			&kp TILDE &kp AT    &kp PLUS  &kp CARET &none        &none      &kp DLLR  &kp EQUAL &kp COLON &none
			&kp FSLH  &kp EXCL  &kp COMMA &kp DOT   &kp ASTRK    &kp HASH   &kp DQT   &kp SQT   &kp PIPE  &kp SEMI
			&kp BSLH  &kp UNDER &kp MINUS &kp AMPS  &none        &tog MOUSE &kp PRCNT &kp QMARK &kp GRAVE &none

			&none &mo FUNC &kp SPACE    &none &none &none
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
		};

		numbrkt_layer {
			display-name = "Numb";
			bindings = <
			&kp PLUS     &kp N1 &kp N2 &kp N3 &kp COMMA    &none    &kp LT   &kp GT   &kp EQUAL &none
			&kp N0       &kp N4 &kp N5 &kp N6 &kp DOT      &kp LBRC &kp LPAR &kp RPAR &kp RBRC  &kp LA(N)
			&kp LS(LGUI) &kp N7 &kp N8 &kp N9 &kp MINUS    &none    &kp LBKT &kp RBKT &none     &none

			&none &none &none    &none &mo FUNC &none
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
		};

		function_layer {
			display-name = "Func";
			bindings = <
			&kp F1 &kp F2  &kp F3  &kp F4  &none    &none      &kp C_BRI_DEC &kp C_BRI_UP &none &to BT
			&kp F5 &kp F6  &kp F7  &kp F8  &none    &kp C_MUTE &kp C_VOL_DN  &kp C_VOL_UP &none &none
			&kp F9 &kp F10 &kp F11 &kp F12 &none    &none      &none         &none        &none &none

			&none &none &none    &none &none &none
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
		};

    xdrive_layer {
			display-name = "XDrv";
			bindings = <
			&none &none &none         &none &none    &none &none        &none &none &none
			&none &none &kp LA(SPACE) &none &none    &none &kp LA(BSPC) &kp BSPC &none &none
			&none &none &tog MOUSE    &none &none    &none &none        &none &none &none

			&none &none &key_repeat    &key_repeat &none &none
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
    };

    mdrive_layer {
			display-name = "MDrv";
			bindings = <
			&none &none    &kp UP   &none     &none    &none &none &none &none &none
			&none &kp LEFT &kp DOWN &kp RIGHT &none    &none &none &none &none &none
			&none &none    &none    &none     &none    &none &none &none &none &none

			&none &none &key_repeat    &key_repeat &none &none
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
    };

		mouse {
			display-name = "Mous";
			bindings = <
			&none  &msc SCRL_RIGHT &msc SCRL_UP   &msc SCRL_LEFT &mkp MCLK      &none          &none          &none        &none           &tog MOUSE
			&none  &mkp MCLK       &mkp RCLK      &mkp LCLK      &none          &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none
			&none  &none           &msc SCRL_DOWN &none          &none          &trans         &mkp MB4       &mkp MCLK    &mkp MB5        &crq_mode CIRQUE_MODE_TOGGLE

			&none &tog MOUSE &hltk NAV SPACE    &none &tog MOUSE &none
			/* &none &kp SPACE &kp LSHIFT    &mkp LCLK &mkp RCLK &none */
			>;
			sensor-bindings = <&enc_ptr_spd &enc_scrl_spd>;
		};

		nav_layer {
			display-name = "Navi";
			bindings = <
			&kp TILDE     &kp TAB       &kp BSPC  &kp RET   &kp LCTRL           &none    &none    &kp LA(SPACE) &none     &none
			&kp LA(SPACE) &kp LG(SPACE) &kp LSHFT &kp LGUI  &kp LC(LA(LGUI))    &kp LEFT &kp DOWN &kp UP        &kp RIGHT &none
			&kp LG(Z)     &kp LG(X)     &kp LG(C) &kp LG(V) &kp LALT            &none    &none    &none         &none     &none

			&none &none &none    &kp TAB &none &none
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
		};

		control_layer {
			display-name = "Blth";
			bindings = <
			&none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none           &none &none &none &none &none
			&none &bt BT_SEL 3 &bt BT_SEL 4 &none        &none           &none &none &none &none &none
			&none &none        &none        &none        &none           &none &none &none &none &none

			&none &to BASE &bt BT_CLR    &none &to BASE &none
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
		};
	};
};
